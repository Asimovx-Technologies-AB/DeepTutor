# Minimal offline example (SQLite). For deployable feature work on Windows,
# use .env.canonical-local.example and the documented setup script.
# DeepTutor Configuration
# Chat, embeddings and vision all read this provider setting.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# Required. Without it the API still starts, but every chat, embedding and
# vision call fails — scanned PDFs and images transcribe to nothing.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Vision model used for scanned pages, diagrams and image uploads.
OPENAI_VLM_MODEL=gpt-4o

# Alternative provider; set LLM_PROVIDER=gemini to use it.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=models/gemini-embedding-2

# Ollama Fallback Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Storage & Database
DATABASE_URL=sqlite+aiosqlite:///./deep_tutor.db
VECTOR_STORE_BACKEND=pgvector
GRAPH_STORE_BACKEND=json_kv
SECRET_KEY=deep-tutor-super-secret-key-change-in-production
UPLOAD_DIR=./uploads
