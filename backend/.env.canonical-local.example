# Canonical Windows development profile. Copy to backend/.env; never commit it.
DEBUG=true
SECRET_KEY=replace-with-a-long-random-local-value

DATABASE_URL=postgresql://deeptutor:deeptutor_local_only@localhost:5432/deeptutor
ALLOW_SQLITE_FALLBACK=false
VECTOR_STORE_BACKEND=pgvector
PGVECTOR_DIMENSIONS=1536
GRAPH_STORE_BACKEND=json_kv

# Canonical validation uses Azure AI Foundry / Azure OpenAI. Run `az login`;
# DefaultAzureCredential uses that identity when no API key is supplied.
LLM_PROVIDER=azure_openai
EMBEDDING_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# Chat may be changed independently while Azure embeddings remain canonical.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=models/gemini-embedding-2

UPLOAD_DIR=./uploads
LIGHTRAG_DATA_DIR=./lightrag_data
ENABLE_S3_STORAGE=false
